---
pagination:
  data: attacks
  size: 1
  alias: attack
permalink: "attack/{{ attack.slug }}/index.html"
layout: base.njk
eleventyComputed:
  title: "{{ attack.title }}"
---
<div class="attack-detail">
  <a href="/" class="back-link">&larr; Return to Chronicle</a>
  <h1>{{ attack.title }}</h1>
  
  <div class="metadata-grid">
    <div class="meta-item"><strong>Target:</strong> {{ attack.target.name }}{% if attack.target.website %} · <a href="{{ attack.target.website }}" target="_blank">website</a>{% endif %}{% if attack.target.repo %} · <a href="{{ attack.target.repo }}" target="_blank">repo</a>{% endif %}</div>
    <div class="meta-item"><strong>Date:</strong> {{ attack.formatted_date }}{% if attack.formatted_end_date and attack.formatted_end_date != "Unknown Date" and attack.formatted_end_date != attack.formatted_date %} to {{ attack.formatted_end_date }}{% endif %}{% if attack.duration and attack.duration != "Same day" %} ({{ attack.duration }}){% endif %}</div>
    <div class="meta-item"><strong>Actor:</strong> {{ attack.actor.name }} ({{ attack.actor.kind }})</div>
    <div class="meta-item"><strong>Target Kind:</strong> {{ attack.target.kind }}</div>
    <div class="meta-item"><strong>Language:</strong> {{ attack.language or "N/A" }}</div>
    <div class="meta-item"><strong>Cause:</strong> {{ attack.method.cause }}</div>
    <div class="meta-item"><strong>Motive:</strong> {{ attack.method.motive }}</div>
    <div class="meta-item"><strong>Transitive:</strong> {{ attack.method.transitive }}</div>
    <div class="meta-item"><strong>Impact:</strong> {{ attack.impact.types | join(", ") }}</div>
    <div class="meta-item"><strong>User Impact:</strong> {{ attack.impact.users or 0 }}</div>
    <div class="meta-item"><strong>Phase:</strong> {{ attack.method.phase }}</div>
    {%- if attack.campaign_links and attack.campaign_links.length > 0 %}
    <div class="meta-item"><strong>Campaigns:</strong>
      {% for campaign in attack.campaign_links %}
        <a href="/campaign/{{ campaign.slug }}/">{{ campaign.title }}</a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </div>
    {%- endif %}
  </div>

  <h2>Synopsis</h2>
  <p class="synopsis">{{ attack.synopsis }}</p>

  {% if attack.story %}
  <h2>Story</h2>
  <div class="story">
    {% for paragraph in attack.story | paragraphs %}
      <p>{{ paragraph }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% if attack.artifacts and attack.artifacts.length > 0 %}
  <h2>Affected Artifacts</h2>
  <div class="artifact-table-wrap">
    <table class="artifact-table">
      <thead>
        <tr>
          <th>Artifact</th>
          <th>Dates</th>
          <th>Versions</th>
          <th>Fixed</th>
          <th>Hashes</th>
        </tr>
      </thead>
      <tbody>
        {% for artifact in attack.artifacts %}
        <tr>
          <td>
            <strong>{{ artifact.name or artifact.package }}</strong>
            {% if artifact.package and artifact.name and artifact.package != artifact.name %}<br><code>{{ artifact.package }}</code>{% endif %}
            {% if artifact.ecosystem or artifact.kind %}<br><span>{{ artifact.ecosystem }}{% if artifact.ecosystem and artifact.kind %} · {% endif %}{{ artifact.kind }}</span>{% endif %}
            {% if artifact.website %}<br><a href="{{ artifact.website }}" target="_blank">{{ artifact.website }}</a>{% endif %}
            {% if artifact.repo %}<br><a href="{{ artifact.repo }}" target="_blank">{{ artifact.repo }}</a>{% endif %}
          </td>
          <td>{{ artifact.start_date or attack.start_date }}{% if artifact.end_date and artifact.end_date != (artifact.start_date or attack.start_date) %}<br>to {{ artifact.end_date }}{% elif not artifact.end_date and attack.end_date and attack.end_date != attack.start_date %}<br>to {{ attack.end_date }}{% endif %}</td>
          <td>
            {% if artifact.versions and artifact.versions.length > 0 %}
              {% for v in artifact.versions %}<code>{{ v }}</code>{% if not loop.last %}<br>{% endif %}{% endfor %}
            {% else %}
              N/A
            {% endif %}
          </td>
          <td>
            {% if artifact.fixed_versions and artifact.fixed_versions.length > 0 %}
              {% for v in artifact.fixed_versions %}<code>{{ v }}</code>{% if not loop.last %}<br>{% endif %}{% endfor %}
            {% else %}
              N/A
            {% endif %}
          </td>
          <td>
            {% if artifact.hashes and artifact.hashes.length > 0 %}
              {% for h in artifact.hashes %}<code>{{ h }}</code>{% if not loop.last %}<br>{% endif %}{% endfor %}
            {% else %}
              N/A
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if attack.locations and attack.locations.length > 0 %}
  <h2>Locations</h2>
  <ul>
    {% for location in attack.locations %}
      <li><code>{{ location.role }}</code>: <code>{{ location.uri }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if attack.indicators and attack.indicators.length > 0 %}
  <h2>Indicators</h2>
  <ul>
    {% for indicator in attack.indicators %}
      <li><code>{{ indicator.kind }}:{{ indicator.value }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if attack.hashes and attack.hashes.length > 0 %}
  <h2>Hashes</h2>
  <ul class="hashes">
    {% for h in attack.hashes %}
      <li><code>{{ h }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if attack.commits and attack.commits.length > 0 %}
  <h2>Commits</h2>
  <ul>
    {% for c in attack.commits %}
      <li><code>{{ c }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if attack.references and attack.references.length > 0 %}
  <h2>References</h2>
  <ul>
    {% for r in attack.references %}
      <li><a href="{{ r.url }}" target="_blank">{{ r.title or r.url }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
