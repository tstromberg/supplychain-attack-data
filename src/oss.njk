---
layout: base.njk
title: Open Source Attacks | Supply-Chain Attack Compendium
---
<div class="page-header">
  <a href="/" class="back-link">&larr; Return to Chronicle</a>
  <h1>Open Source</h1>
  <p class="subtitle">The treacherous wildlands of community code.</p>
</div>

<div class="timeline">
  {% set currentYearOss = 0 %}
  {% for attack in attacks %}
    {% if attack.category == 'OSS' %}
      {% if attack.year != currentYearOss and attack.year > 1970 %}
        <div class="timeline-year-wrapper">
          <h3 class="year-marker">{{ attack.year }}</h3>
        </div>
        {% set currentYearOss = attack.year %}
      {% endif %}
      <div class="timeline-item {% if loop.index0 % 2 == 0 %}side-right{% else %}side-left{% endif %}">
        <div class="timeline-content">
          <div class="timeline-date">{{ attack.formatted_date }}</div>
          <h4><a href="/attack/{{ attack.slug }}/">{{ attack.title }}</a></h4>
          <p class="attack-meta"><strong>Target:</strong> {{ attack.name }} | <strong>Impact:</strong> {{ attack.impact_type }}</p>
          <p class="attack-synopsis">{{ attack.synopsis | truncate(180) }}</p>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>
