---
pagination:
  data: campaigns
  size: 1
  alias: campaign
permalink: "campaign/{{ campaign.slug }}/index.html"
layout: base.njk
eleventyComputed:
  title: "{{ campaign.title }}"
---
<div class="attack-detail">
  <a href="/" class="back-link">&larr; Return to Chronicle</a>
  <h1>{{ campaign.title }}</h1>

  <div class="metadata-grid">
    <div class="meta-item"><strong>Campaign:</strong> {{ campaign.name }}</div>
    <div class="meta-item"><strong>Date:</strong> {{ campaign.formatted_date }}{% if campaign.formatted_end_date and campaign.formatted_end_date != "Unknown Date" and campaign.formatted_end_date != campaign.formatted_date %} to {{ campaign.formatted_end_date }}{% endif %}{% if campaign.duration and campaign.duration != "Same day" %} ({{ campaign.duration }}){% endif %}</div>
    {% if campaign.attribution_type %}<div class="meta-item"><strong>Attribution:</strong> {{ campaign.attribution_type }}</div>{% endif %}
    {% if campaign.cause %}<div class="meta-item"><strong>Cause:</strong> {{ campaign.cause }}</div>{% endif %}
    {% if campaign.motive %}<div class="meta-item"><strong>Motive:</strong> {{ campaign.motive }}</div>{% endif %}
    {% if campaign.impact_type %}<div class="meta-item"><strong>Impact Type:</strong> {{ campaign.impact_type }}</div>{% endif %}
    {% if campaign.impact_user_count %}<div class="meta-item"><strong>User Impact:</strong> {{ campaign.impact_user_count }}</div>{% endif %}
  </div>

  {% if campaign.synopsis %}
  <h2>Synopsis</h2>
  <p class="synopsis">{{ campaign.synopsis }}</p>
  {% endif %}

  {% if campaign.members and campaign.members.length > 0 %}
  <h2>Member Attacks</h2>
  <div class="record-list">
    {% for attack in campaign.members %}
      <div class="record-list-item">
        <div class="timeline-date">{{ attack.formatted_date }}</div>
        <h4><a href="/attack/{{ attack.slug }}/">{{ attack.title }}</a></h4>
        <p class="attack-meta"><strong>Target:</strong> {{ attack.name }} | <strong>Impact:</strong> {{ attack.impact_type }}</p>
      </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if campaign.versions and campaign.versions.length > 0 %}
  <h2>Campaign Artifact Notes</h2>
  <ul>
    {% for v in campaign.versions %}
      <li><code>{{ v }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if campaign.hashes and campaign.hashes.length > 0 %}
  <h2>Hashes</h2>
  <ul class="hashes">
    {% for h in campaign.hashes %}
      <li><code>{{ h }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if campaign.references and campaign.references.length > 0 %}
  <h2>References</h2>
  <ul>
    {% for r in campaign.references %}
      <li><a href="{{ r }}" target="_blank">{{ r }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
