# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
out/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Acquired incident samples are the point of this repository. The Go binary patterns
# above match by extension, so without these exceptions a malicious .exe, .dll, or
# .dylib payload is verified into a manifest and then silently left uncommitted.
#!oss/attacks/**/samples/**
#!proprietary/**/samples/**

**/samples/before/
**/samples/during/
**/samples/after/

.cache/

# Sample payloads live in the artifact tree (~/data/supplychain-attack-data, synced to R2),
# not in git. What stays here is the text that describes them: the manifest, which is the
# authority on what the corpus claims to hold, and the digest-keyed provenance store.
# Rebuild the artifact tree with `node tools/build-artifacts.js --apply` and check it
# against these records with `node tools/verify-store.js`.
**/samples/*
!**/samples/manifest.yaml
!**/samples/provenance/

# Installed by npm; js-yaml is the only dependency and package.json names it.
node_modules/
